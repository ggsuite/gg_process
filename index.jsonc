{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "gg_process",

  // 1-2 sentence summary about this repo.
  "summary": "Process execution of the gg suite: one replaceable delegate for every process gg starts, a mockable wrapper and a platform delegate for Wasm embedders.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "process execution: GgProcessDelegate (dart:io or a host, e.g. Node), GgProcessWrapper, ggRunProcess / ggStartProcess, GgFakeProcess",
    "platform: GgPlatformDelegate (environment, operating system, exit code), ggPlatform, ggExitCode",
    "Windows: GgWindowsExecutable starts batch files such as flutter, npm, pnpm by their full path, so no shell is needed",
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {
      "dna_ggsuite": "dev: DNA layer: guides, templates",
      "helix": "dev: runDnaTest",
    },

    // "<repo-b>": "why / API"
    "usedBy": {
      "gg_one_core": "process runner of the checks, e.g. pub get --offline",
      "gg_lang": "catalog commands such as flutter pub publish, registry lookups",
      "gg_git": "defaultProcessRunner of every git call",
      "gg_test": "runs dart test / flutter test",
      "gg_publish": "pub outdated, uploads",
    },
  },
}
